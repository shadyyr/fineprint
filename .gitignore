# ── Secrets ──────────────────────────────────────────────────────────────
# No leading slash, so these match at any depth: api/.env and web/.env.local
# are both covered. `.env.*` catches .env.production and friends, which a
# bare `.env.local` pattern would miss.
.env
.env.*
!.env.example
*.pem
*.key
*.p12
credentials.json
secrets.json
.secrets/

# ── Student data ─────────────────────────────────────────────────────────
# Aid letters contain personal information (master context 6.11). These paths
# are the designated landing zone for anything real: it stays on disk, never
# in the repo. Only synthetic letters and publicly published institutional
# samples belong in fixtures/ and corpus/letters/.
uploads/
private/
scratch/
*.private.pdf

# ── Dependencies ─────────────────────────────────────────────────────────
node_modules/
.venv/
venv/
__pycache__/
*.py[cod]

# ── Build output ─────────────────────────────────────────────────────────
.next/
out/
.turbo/
*.tsbuildinfo
web/next-env.d.ts

# ── Generated artifacts ──────────────────────────────────────────────────
# The pdf.js worker is 1.2 MB and is recreated by the sync:pdfworker script on
# every npm install, including on the deployment host, so it is not committed.
web/public/pdf.worker.min.mjs

# web/public/sample_offer.{pdf,json} ARE committed, even though
# scripts/make_fixture.py generates them. They are produced by a Python script
# that does not run on a JS-only deployment host, so ignoring them ships a
# build where the sample offer 404s. Small, deterministic, and regenerated in
# place by make_fixture.py -- do not hand-edit them.

# ── Logs and caches ──────────────────────────────────────────────────────
# Server logs can contain extracted document text, so they never get committed.
*.log
# ...except the agent handoff log, which is the whole point of docs/.
!docs/CHANGES.log
npm-debug.log*
yarn-error.log*
.pytest_cache/
.ruff_cache/
coverage/

# ── Local machine state ──────────────────────────────────────────────────
.claude/settings.local.json

# ── OS / editor ──────────────────────────────────────────────────────────
.DS_Store
*.swp
.idea/
