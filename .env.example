# Copy to api/.env and fill in. api/.env is gitignored and must stay that way.
#
#   cp .env.example api/.env
#
# Get a key at https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=

# Model used for structured extraction.
FINEPRINT_MODEL=claude-opus-5

# Where the Next.js proxy reaches the extraction service.
FINEPRINT_API_URL=http://127.0.0.1:8000
