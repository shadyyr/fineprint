# FinePrint environment variables.
#
# There are TWO consumers and therefore two files. Copy the relevant block into
# the right one -- both are gitignored.
#
#   Python extraction service  ->  api/.env
#   Next.js web app            ->  web/.env.local
#
# Nothing in this file is secret; it documents variable names and safe
# defaults. Never put a real key here.


# ───────── api/.env — the Python extraction service ─────────

# Create a project key at https://platform.openai.com/api-keys
OPENAI_API_KEY=

# Terra handles normal extraction at medium reasoning. Sol is called only when
# Terra fails the typed output contract, no financial fact verifies, or the
# deterministic evidence gate rejects a claim. Ambiguity is not a failure.
FINEPRINT_MODEL=gpt-5.6-terra
FINEPRINT_FALLBACK_MODEL=gpt-5.6-sol
FINEPRINT_REASONING_EFFORT=medium

# Public-host safety controls. Leave public mode off for local development.
# The API's Vercel project sets public mode on but keeps the analysis route
# disabled through its first deployment and checks.
FINEPRINT_PUBLIC_MODE=false
FINEPRINT_PUBLIC_API_ENABLED=false

# Public-mode quota defaults: at most 3 attempts per client per hour and 25
# provider-backed analyses across the whole service per UTC day. Invalid PDFs
# count against the per-client limit but not the daily provider-call budget.
FINEPRINT_RATE_LIMIT_REQUESTS=3
FINEPRINT_RATE_LIMIT_WINDOW_SECONDS=3600
FINEPRINT_DAILY_ANALYSIS_CAP=25

# Required only in public mode. Use a generated random secret; never reuse the
# OpenAI key. Redis keys contain HMAC digests, not raw client addresses.
FINEPRINT_IP_HASH_SECRET=

# Shared only by the web and API Vercel projects. Public /analyze accepts a
# request only when this matches X-FinePrint-Proxy-Secret, then uses the
# validated X-FinePrint-Client-IP for quotas. Direct calls fail closed.
FINEPRINT_PROXY_SECRET=

# Added automatically when the Vercel Marketplace Upstash Redis resource is
# connected. Direct Upstash connections may instead use
# UPSTASH_REDIS_REST_URL and UPSTASH_REDIS_REST_TOKEN; never expose any token.
KV_REST_API_URL=
KV_REST_API_TOKEN=


# ───────── web/.env.local — the Next.js app ─────────

# Where the Next.js route handlers reach the Python service. Server-side only
# (deliberately no NEXT_PUBLIC_ prefix) so the browser never talks to FastAPI
# directly and the API key stays off the client.
#
# Leave this unset for local development -- web/lib/api.ts already defaults to
# http://127.0.0.1:8000, which is where `npm run dev` starts the service.
#
# Only set it if the Python service runs somewhere else. Note that it must be
# reachable from wherever Next.js is running: on a hosted deployment that means
# a public URL. Pointing a deployed app at 127.0.0.1 resolves to the server's
# own loopback, not your laptop, so upload and analysis will fail.
FINEPRINT_API_URL=http://127.0.0.1:8000

# In production, set this to the exact same random value as the API project's
# FINEPRINT_PROXY_SECRET. It is server-side only and must never use a
# NEXT_PUBLIC_ prefix.
FINEPRINT_PROXY_SECRET=
