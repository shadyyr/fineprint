#!/usr/bin/env bash
#
# Blocks secrets and student data from being committed.
#
# Lives in .githooks/ rather than .git/hooks/ so it is version controlled and
# survives a fresh clone. Activate with:
#
#   git config core.hooksPath .githooks
#
# Bypass in a genuine emergency with `git commit --no-verify`.

exec "$(git rev-parse --show-toplevel)/scripts/check_secrets.sh" --staged
